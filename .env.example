# Hangi Claude arka ucu: auto | api | claude-code
#   auto: ANTHROPIC_API_KEY varsa API, yoksa bilgisayardaki Claude Code oturumu
WEBAGENT_BACKEND=auto
# Sadece api arka ucu için gerekli
ANTHROPIC_API_KEY=
# claude-code bulunamazsa claude.exe yolunu elle verin
# CLAUDE_CLI_PATH=
# Kullanılacak model (varsayılan: claude-opus-5)
WEBAGENT_MODEL=claude-opus-5
# Yerel platform arayüzü portu
WEBAGENT_PORT=8000
